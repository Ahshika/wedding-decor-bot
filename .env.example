# ==========================================
# Server Configuration
# ==========================================
PORT=3000

# ==========================================
# Meta Webhook & Page Configuration
# (Facebook Messenger / WhatsApp Cloud API)
# ==========================================
# token you set in Meta Developers Webhook settings
VERIFY_TOKEN=my_wedding_bot_verify_token_2026

# Meta Page Access Token (Messenger) or System User Token (WhatsApp)
PAGE_ACCESS_TOKEN=EAABb_your_meta_page_access_token_here

# Optional: WhatsApp Phone Number ID (if using WhatsApp Cloud API instead of Messenger)
# WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id_here

# ==========================================
# Google Gemini API Configuration
# Get free API key from https://aistudio.google.com/
# ==========================================
GEMINI_API_KEY=AIzaSy_your_google_gemini_api_key_here
