# ==========================================
# Server Configuration
# ==========================================
PORT=3000

# ==========================================
# Meta Webhook & Page Configuration
# (Facebook Messenger / WhatsApp Cloud API)
# ==========================================
# token you set in Meta Developers Webhook settings
VERIFY_TOKEN=my_wedding_bot_verify_token_2026

# App Secret from Meta Developers > App Settings > Basic
# Used to verify that webhook requests really come from Meta (X-Hub-Signature-256).
# REQUIRED in production. If empty, signature verification is disabled.
APP_SECRET=your_meta_app_secret_here

# Meta Page Access Token (Messenger)
PAGE_ACCESS_TOKEN=EAABb_your_meta_page_access_token_here

# Optional: separate System User Token for WhatsApp (falls back to PAGE_ACCESS_TOKEN)
# WHATSAPP_TOKEN=your_whatsapp_system_user_token_here

# Optional: Graph API version (default: v23.0)
# GRAPH_API_VERSION=v23.0

# ==========================================
# Google Gemini API Configuration
# Get free API key from https://aistudio.google.com/
# ==========================================
GEMINI_API_KEY=AIzaSy_your_google_gemini_api_key_here

# Optional: Gemini model (default: gemini-2.5-flash)
# GEMINI_MODEL=gemini-2.5-flash

# ==========================================
# Conversation Memory
# ==========================================
# How many past messages the bot remembers per customer (default: 20)
# MAX_HISTORY_MESSAGES=20
# Forget a conversation after this many hours of silence (default: 24)
# CONVERSATION_TTL_HOURS=24

# ==========================================
# Persistent Storage (optional but recommended on Render free plan)
# Free Redis from https://upstash.com -> Create Database -> REST API section
# Without these, memory is lost every time the server restarts.
# ==========================================
# UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your_upstash_token_here

# ==========================================
# Owner Notifications - Telegram
# 1. Talk to @BotFather on Telegram -> /newbot -> copy the token
# 2. Send any message to your new bot, then open:
#    https://api.telegram.org/bot<TOKEN>/getUpdates  and copy "chat":{"id": ...}
# ==========================================
# TELEGRAM_BOT_TOKEN=123456:ABC-your-telegram-bot-token
# TELEGRAM_CHAT_ID=123456789

# ==========================================
# Save Leads to Google Sheets
# See google-apps-script/leads.gs for setup steps
# (works with any webhook: Make, Zapier, n8n...)
# ==========================================
# LEADS_WEBHOOK_URL=https://script.google.com/macros/s/XXXX/exec
# LEADS_WEBHOOK_SECRET=same_secret_as_in_leads_gs

# ==========================================
# Human Handoff
# ==========================================
# How long the bot stays silent with a customer after they ask for a human
# or after someone replies manually from the Page inbox (default: 12)
# HANDOFF_PAUSE_HOURS=12   (default business on first start; then edit it from the dashboard)
# Set to false to keep the bot replying even when a human replies from the Page inbox
# PAUSE_ON_HUMAN_REPLY=true
# Public URL of the server, used for the "resume bot" link (auto-detected on Render)
# PUBLIC_URL=https://wedding-decor-bot.onrender.com
# Secret used to sign the "resume bot" links (defaults to APP_SECRET)
# ADMIN_SECRET=another_long_random_secret

# Timezone of the default business on first start (then edit it from the dashboard)
# TIMEZONE=Africa/Cairo

# ==========================================
# Images, Voice Notes & Catalog
# ==========================================
# Max size of an image / voice note sent to Gemini, in MB (default: 15)
# MAX_MEDIA_MB=15
# Path to the catalog file (default: catalog.json in the project root)
# CATALOG_FILE=./catalog.json

# ==========================================
# Dashboard & Multiple Businesses (/dashboard)
# ==========================================
# Admin password for the dashboard (min 10 characters). Without it the dashboard is disabled.
ADMIN_PASSWORD=change_me_to_a_long_password
# Optional: extra secret used to sign dashboard login cookies
# DASHBOARD_SECRET=another_long_random_secret
# Name of the default business created on first start (default: Joy Decor & Events)
# BUSINESS_NAME=Joy Decor & Events
# How many days conversations are kept for the dashboard (default: 30)
# HISTORY_RETENTION_DAYS=30
